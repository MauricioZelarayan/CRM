datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
}

model Organization {
  id         String       @id @default(uuid())
  name       String
  users      User[]
  contacts   Contact[]
  deals      Deal[]       // <-- Relación inversa requerida por Deal
  activities Activity[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  password       String       // Hash con bcrypt (12 rounds)
  firstName      String
  lastName       String?
  role           Role         @default(USER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("users")
}

model Contact {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]       // <-- Relación inversa requerida por Deal
  activities     Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("contacts")
}

model Deal {
  id             String       @id @default(uuid())
  title          String
  value          Decimal      @db.Decimal(12, 2)
  stage          DealStage    @default(LEAD)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@map("deals")
}

model Activity {
  id             String       @id @default(uuid())
  type           ActivityType @default(NOTE)
  title          String
  description    String?
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@map("activities")
}