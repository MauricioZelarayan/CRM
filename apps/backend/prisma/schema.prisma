datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
}

enum TriggerEvent {
  DEAL_STAGE_CHANGED
  DEAL_WON
  CONTACT_CREATED
}

enum ActionType {
  CREATE_TASK
  SEND_EMAIL
  NOTIFY_TEAM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// MODELOS PRINCIPALES
// ==========================================

model Organization {
  id               String            @id @default(uuid())
  name             String
  users            User[]
  contacts         Contact[]
  deals            Deal[]
  activities       Activity[]
  workflows        Workflow[] // <-- Relación inversa agregada
  products         Product[] // <-- Relación inversa agregada
  tickets          Ticket[] // <-- Relación inversa agregada
  webhookEndpoints WebhookEndpoint[] // <-- Relación inversa agregada
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("organizations")
}

// ==========================================

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String // Hash con bcrypt (12 rounds)
  firstName       String
  lastName        String?
  role            Role            @default(USER)
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[] // <-- Relación inversa para Ticket.assignedTo
  ticketMessages  TicketMessage[] // <-- Relación inversa para TicketMessage.sender
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
  @@map("users")
}

// ==========================================

model Contact {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  activities     Activity[]
  tickets        Ticket[] // <-- Relación inversa para Ticket.contact
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("contacts")
}

// ==========================================

model Deal {
  id             String        @id @default(uuid())
  title          String
  value          Decimal       @db.Decimal(12, 2)
  stage          DealStage     @default(LEAD)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealProducts   DealProduct[] // <-- Relación inversa para DealProduct.deal
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@map("deals")
}

// ==========================================
// ACTIVIDADES
// ==========================================

model Activity {
  id             String       @id @default(uuid())
  type           ActivityType @default(NOTE)
  title          String
  description    String?
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@map("activities")
}

// ==========================================
// MOTOR DE AUTOMATIZACIONES (WORKFLOWS)
// ==========================================

model Workflow {
  id             String           @id @default(uuid())
  name           String
  description    String?
  triggerEvent   TriggerEvent
  active         Boolean          @default(true)
  actions        WorkflowAction[]
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@map("workflows")
}

// ==========================================

model WorkflowAction {
  id         String     @id @default(uuid())
  actionType ActionType
  payload    Json // Configuración en JSON para el worker/servicio
  workflowId String
  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@index([workflowId])
  @@map("workflow_actions")
}

// ==========================================
// PRODUCTOS Y COTIZACIONES
// ==========================================

model Product {
  id             String        @id @default(uuid())
  name           String
  sku            String?
  description    String?
  price          Decimal       @db.Decimal(12, 2)
  active         Boolean       @default(true)
  dealProducts   DealProduct[]
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@map("products")
}

// ==========================================

model DealProduct {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2) // Precio congelado al momento de la venta
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([productId])
  @@map("deal_products")
}

// ==========================================
// ATENCIÓN AL CLIENTE / TICKETS
// ==========================================

model Ticket {
  id             String          @id @default(uuid())
  subject        String
  status         TicketStatus    @default(OPEN)
  priority       TicketPriority  @default(MEDIUM)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       TicketMessage[]
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([assignedToId])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  body      String   @db.Text
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

// ==========================================
// WEBHOOKS EXTERNOS (LEADS)
// ==========================================

model WebhookEndpoint {
  id             String       @id @default(uuid())
  name           String
  secretKey      String       @unique @default(uuid())
  active         Boolean      @default(true)
  logs           WebhookLog[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookLog {
  id           String          @id @default(uuid())
  payload      Json
  processed    Boolean         @default(false)
  errorMessage String?         @db.Text
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@index([endpointId])
  @@map("webhook_logs")
}
